-- SPDX-License-Identifier: Apache-2.0
-- Trotter–Suzuki Hamiltonian simulation (first-order product formula).
-- ▶ Application harness + classical cross-check: crates/apps/trotter/src/lib.rs
--   run: cargo run -p aria-app-trotter   (or: cargo run -p aria-verify -- trotter)
-- VERIFIED: circuit ⟨Z_q⟩ after evolving H = 0.5·Z0Z1 + 0.35·(X0+X1) to t = 1 vs the exact
--   dense matrix exponential exp(-iHt); the first-order Trotter error → 0 as `steps` → ∞
--   (e.g. 3.1e-8 → 7.6e-9 as steps 750 → 1500), |Δ| ≤ 2e-3 at steps = 1500.
--
-- One first-order Trotter step approximates exp(-i·dt·H) by the product of the per-term
-- exponentials: exp(-i·a·dt·Z⊗Z)·exp(-i·b·dt·X₀)·exp(-i·b·dt·X₁). With Aria's Qiskit gate
-- convention RX(θ)=exp(-iθ/2·X) the transverse-field angle is 2·b·dt; the Z⊗Z rotation
-- RZZ(θ)=exp(-iθ/2·Z⊗Z) is spelled in the universal gate set as CX·(I⊗RZ(θ))·CX, θ = 2·a·dt.

@assert unitary
@bound qubits = 2

circuit Trotter(steps: int) {
    qreg q[2]

    let T  = 1.0            -- total evolution time
    let a  = 0.5            -- Z0Z1 coupling
    let b  = 0.35           -- transverse field on each qubit
    let dt = T / steps      -- Trotter time-slice (compile-time float fold)

    repeat s from 0 to steps - 1 {
        -- exp(-i·a·dt·Z⊗Z) = CX · RZ(2·a·dt) on target · CX
        apply CX on q[0], q[1]
        apply RZ(2 * a * dt) on q[1]
        apply CX on q[0], q[1]
        -- exp(-i·b·dt·X) on each qubit
        apply RX(2 * b * dt) on q[0]
        apply RX(2 * b * dt) on q[1]
    }
}
