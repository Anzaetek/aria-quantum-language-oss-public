-- HHL (Harrow–Hassidim–Lloyd) — quantum linear-system solver.
-- Rust harness: crates/apps/forward/src/lib.rs  (cargo run -p aria-verify -- hhl)
-- VERIFIED: omega forward ⟨Z_q⟩ profile vs an independent in-tree statevector oracle on the same lowered IR, |Δ| ≤ 1e-9.
--
-- Solves A x = b for Hermitian A. The diagonal A = diag(1, 2),
-- b = |1⟩ case (analytic solution x = |1⟩/2) is the smoke test
-- driven from the Rust side; this Aria template generalizes it
-- across the counting-register width parameter `n`.

@assert unitary
@prove "hhl_recovers_inverse" equiv { encodes A^{-1} b in ancilla=|1> branch }
@bound counting_qubits = n

circuit Hhl(n: int) {
    qreg q[5]            -- worst-case width: 3 counting + 1 system + 1 ancilla
    creg c[1]

    -- Step 1: prepare |b⟩ on system qubit (index n).
    apply X on q[n]

    -- Step 2: QPE on the counting register.
    --
    -- `repeat … to B` is INCLUSIVE (GRAMMAR.md:93), and the system qubit is
    -- index n — so `0 to n` ran over the counting register PLUS the system
    -- qubit. That put an H on q[n] immediately after the X that prepares |b⟩,
    -- destroying the state being solved for, and made the k = n iteration
    -- below `CP on q[n], q[n]`: a phase gate controlling itself. The backend
    -- accepted that and aliased its way to a confident wrong answer.
    repeat i from 0 to n - 1 {
        apply H on q[i]
    }
    repeat k from 0 to n - 1 {
        -- controlled-U^{2^k}: phase 2π · 2^k / 2^n on system qubit.
        let angle = 2 * pi * 2^k / 2^n
        apply CP(angle) on q[k], q[n]
    }

    -- Step 3: inverse QFT on counting register (manual, for clarity).
    repeat i from 0 to n - 1 {
        apply H on q[i]
    }

    -- Step 4: controlled rotation encoding 1/λ on the ancilla. HHL needs a
    -- controlled-RY here — rotate the fresh |0⟩ ancilla by ~C/λ so that
    -- post-selecting ancilla = |1⟩ yields the 1/λ-weighted A⁻¹|b⟩ amplitude.
    -- A controlled-PHASE (the previous version) is diagonal, so on a |0⟩ ancilla
    -- it is a no-op: the ancilla never leaves |0⟩ and the solution branch is
    -- empty for every input. Aria has no native CRY, so decompose
    -- CRY(φ) = RY(φ/2)·CX·RY(-φ/2)·CX (φ = C/λ, eigenvalue proxy λ = k + 1).
    repeat k from 0 to n - 1 {
        let theta = 0.5 / (k + 1)
        apply RY(theta / 2) on q[n + 1]
        apply CX on q[k], q[n + 1]
        apply RY(-theta / 2) on q[n + 1]
        apply CX on q[k], q[n + 1]
    }

    -- Step 5: uncompute QPE. Same inclusive-bound correction as Step 2 — and
    -- an uncompute that ranged over a different set than the compute would not
    -- have uncomputed anything.
    repeat k from 0 to n - 1 {
        let angle = -2 * pi * 2^k / 2^n
        apply CP(angle) on q[k], q[n]
    }
    repeat i from 0 to n - 1 {
        apply H on q[i]
    }

    -- Measure ancilla; post-select on |1⟩ for the solution branch.
    measure q[n + 1] -> c[0]
}
