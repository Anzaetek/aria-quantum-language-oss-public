// 4-mode quantum Fourier transform as a multiport interferometer.
//
// References:
//   M. Reck, A. Zeilinger, H. J. Bernstein and P. Bertani, "Experimental
//   realization of any discrete unitary operator", Phys. Rev. Lett. 73, 58
//   (1994) -- the triangular decomposition used to generate this file.
//
//   W. R. Clements, P. C. Humphreys, B. J. Metcalf, W. S. Kolthammer and
//   I. A. Walmsley, "Optimal design for universal multiport interferometers",
//   Optica 3(12), 1460-1465 (2016), arXiv:1603.08788 -- a symmetric mesh with
//   HALF the optical depth. Not implemented here; see decompose.rs.
//
// The DFT, U[j][k] = exp(2*pi*i*j*k/m)/sqrt(m), is a unitary on m modes, and any
// unitary is realisable as a mesh of beam splitters and phase shifters. This
// file IS that mesh: 3 phase shifters + 6 beam splitters, generated by
// `cargo run -p omega-backend-photonics --example gen_qft`, which reports
// recomposition to 2.884e-16.
//
// Run it with aria:
//   omega-run examples/circuits/qft4.opticqasm --backend photonics \
//     --input 1,0,0,0 --shots 200000
//
// See docs/PHOTONICS_EXAMPLES.md for the Perceval invocation.
//
// WHAT TO CHECK, AND WHAT NOT TO BOTHER WITH.
//
// A single photon entering any one mode leaves uniformly, 1/4 per mode. That is
// true, and it is a WEAK check: it only constrains |U_jk| = 1/sqrt(m), so every
// complex Hadamard passes it. Measured at m=4, all of these pass while being
// visibly not the DFT: the real Hadamard H(x)H/2 (distance 1.0 from the DFT),
// the continuous family F4(a=0.7) (0.34), and a row-permuted DFT (1.0).
//
// The sharp check is the FOURIER SUPPRESSION LAW:
//
//   M. C. Tichy, M. Tiersch, F. de Melo, F. Mintert and A. Buchleitner,
//   "Zero-transmission law for multiport beam splitters",
//   Phys. Rev. Lett. 104, 220405 (2010).
//
// For a CYCLIC multi-photon input -- here |1,1,1,1>, one photon per mode -- every
// output whose occupation satisfies
//
//   sum_j  j * n_j  !=  0   (mod m)
//
// is STRICTLY FORBIDDEN: an exact zero, not a small number. Roughly half the
// output configurations vanish. Two properties make this the right test:
//
//   1. Exact zeros cannot be reproduced by accident. A wrong-but-unitary mesh
//      leaks into the suppressed outputs.
//   2. It exercises the PERMANENT. Recomposing the unitary (decompose_independent.rs)
//      tests the mesh algebra and never touches the multi-photon path at all.
//
// Run the suppression check:
//   omega-run examples/circuits/qft4.opticqasm --backend photonics \
//     --input 1,1,1,1 --shots 200000
//
// Allowed (sum j*n_j = 0 mod 4) include |1,1,1,1> (0+1+2+3=6, NOT 0 mod 4 ->
// forbidden, so do not expect the input back), |2,0,2,0| (0+4=4 = 0 mod 4 ->
// allowed), |4,0,0,0> (0 -> allowed). Anything with sum j*n_j = 1, 2 or 3 mod 4
// must come back empty.

OPTICQASM 1.0;
photon q[4];

// Reck decomposition of the 4x4 DFT. Angles are concrete so the file stays
// readable and diffable rather than being an opaque matrix dump.
ps(3.141592653589793) q[1];
ps(1.249045772398254) q[2];
ps(0.321750554396642) q[3];
bs_rx(0.785398163397448, 4.068887871591405) q[2], q[3];
bs_rx(0.955316618124509, 5.034139534781332) q[1], q[2];
bs_rx(0.659058035826409, -1.107148717794090) q[2], q[3];
bs_rx(1.047197551196598, 0.000000000000000) q[0], q[1];
bs_rx(0.955316618124509, 0.000000000000000) q[1], q[2];
bs_rx(0.785398163397448, 0.000000000000000) q[2], q[3];
