/target
**/target
# Cross-build target dir used by the Linux/CUDA passes (--target-dir target-linux)
/target-linux
**/*.rs.bk
Cargo.lock.bk

# Python bridge virtualenvs / caches (opt-in bridges build these locally)
**/.venv*
**/__pycache__
**/*.pyc
**/.pytest_cache
**/node_modules

# Local runtime/state
*.db
*.token
.DS_Store

# Lean 4 / lake build artifacts + mathlib cache (multi-GB; never commit)
proofs/lean4/.lake/
**/*.olean
fixes/
.codegraph

# libtorch env file written by tools/setup-libtorch.sh
tch-env.sh

# Compiled Python extension modules (built by maturin)
**/*.so
**/*.pyd
.venv-qiskit/

# TLA+ model checker (fetched locally; see tools/tla/check.sh)
tools/tla/tla2tools.jar
# Cross-build target dir used by the tch/libtorch pass (CARGO_BUILD_TARGET splits
# host and target artifacts, so cargo puts them here).
/target-tch
