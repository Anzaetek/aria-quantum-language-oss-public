// QASM 2.0 PEG grammar for pest

// The version statement is OPTIONAL. OpenQASM 3 says so in as many words, and
// the specification's own examples take it at its word: of the 21 programs in
// `third_party/openqasm-examples/`, **20 carry no `OPENQASM` line at all** and
// the twenty-first writes `OPENQASM 3;`. A mandatory `D.D` header rejected the
// entire corpus before a single statement was read.
program = { SOI ~ header? ~ statement* ~ EOI }

header = { "OPENQASM" ~ version ~ ";" }
// The minor version is optional too: `OPENQASM 3;` is what `teleport.qasm`
// writes, and it failed here at the `.` — measured as a bare `--> 2:10`.
version = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }

statement = {
    include_stmt
  | qubit_decl_v3
  | bit_decl_v3
  | qreg_decl
  | creg_decl
  | gate_def
  | measure_assign_v3
  | measure_stmt
  | barrier_stmt
  | reset_stmt
  | if_stmt
  | gate_app_stmt
}

include_stmt = { "include" ~ string_lit ~ ";" }
string_lit   = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }

// QASM 2 register declarations.
qreg_decl = { "qreg" ~ ident ~ "[" ~ integer ~ "]" ~ ";" }
creg_decl = { "creg" ~ ident ~ "[" ~ integer ~ "]" ~ ";" }

// QASM 3 register declarations — `qubit[n] q;`, `bit[n] c;` — accepted
// alongside the QASM 2 forms so a header `OPENQASM 3.0;` parses with
// the same grammar. Both lower to the same `QregDecl` / `CregDecl`
// AST variant.
// The size is OPTIONAL: `qubit q;` / `bit c;` declare a single qubit or bit and
// are what `qpt.qasm` and `teleport.qasm` write. Without this they did not fail
// as declarations at all — the ordered choice fell through to `gate_app_stmt`,
// which happily matched `qubit` as a GATE NAME and `q` as its operand, so the
// file parsed and died at lowering with `unknown gate: qubit`. That is the same
// trap recorded for `reset` below: a rule that does not match is not a rule
// that refuses.
qubit_decl_v3 = { "qubit" ~ ("[" ~ integer ~ "]")? ~ ident ~ ";" }
bit_decl_v3   = { "bit"   ~ ("[" ~ integer ~ "]")? ~ ident ~ ";" }

gate_def = {
    "gate" ~ ident ~ param_list_def? ~ qubit_list_def ~ "{" ~ gate_body ~ "}"
}
param_list_def = { "(" ~ ident ~ ("," ~ ident)* ~ ")" }
qubit_list_def = { ident ~ ("," ~ ident)* }
gate_body      = { gate_app_stmt* }

gate_app_stmt = { gate_modifier* ~ gate_name ~ param_list_app? ~ qubit_list_app ~ ";" }

// QASM 3 gate modifiers. `inv @ U` reflects the gate's unitary; `pow(n) @ U`
// applies the gate `n` times. Modifiers chain right-to-left (`inv @ pow(3) @ x`
// = `inv @ (x; x; x)` = `x; x; x` since each `x` is self-inverse). Both are
// accepted but reject in lowering if `n` is non-positive or the inv has no
// closed-form (the current lowering covers Clifford + rotation gates).
gate_modifier = { inv_modifier | pow_modifier }
inv_modifier  = { "inv" ~ "@" }
pow_modifier  = { "pow" ~ "(" ~ integer ~ ")" ~ "@" }
gate_name     = @{ ident }
param_list_app = { "(" ~ expr ~ ("," ~ expr)* ~ ")" }
qubit_list_app = { qubit_ref ~ ("," ~ qubit_ref)* }

qubit_ref = { ident ~ "[" ~ integer ~ "]" | ident }
cbit_ref  = { ident ~ "[" ~ integer ~ "]" | ident }

measure_stmt = { "measure" ~ qubit_ref ~ "->" ~ cbit_ref ~ ";" }
// QASM 3 assignment form: `c[i] = measure q[i];`. Lowers identically to the
// QASM 2 `measure q -> c;` form (operand order reversed in the syntax).
measure_assign_v3 = { cbit_ref ~ "=" ~ "measure" ~ qubit_ref ~ ";" }
barrier_stmt = { "barrier" ~ qubit_list_app ~ ";" }
reset_stmt   = { "reset" ~ qubit_ref ~ ";" }

// A guard may wrap a gate application, a `measure`, or a `reset`.
//
// It accepted only `gate_app_stmt`, so `if (c==1) measure q[0] -> c[0];` was a
// PARSE error here while qiskit accepts it and this workspace's own emitter
// produces it — a file we write, that we cannot read. (`reset` parsed, because
// it looks like a gate application, and then died at lowering with "unknown
// gate: reset".)
// ORDER MATTERS: pest's `|` is an ordered choice, and `gate_app_stmt` would
// match `reset q[0];` as a gate application named `reset` — which parsed, then
// died at lowering with "unknown gate: reset". The specific forms go first.
// The body may also be a BRACED BLOCK — `if (c1==1) { x q[2]; }`. OpenQASM 3
// allows either form ("braces optional in this case", as `teleport.qasm`'s own
// comment puts it), and both `teleport.qasm` and `inverseqft2.qasm` use braces.
// A block may hold more than one statement, and every one of them inherits the
// guard.
// The condition target may be a whole register (`c == 1`, QASM 2.0's form and
// OpenQASM 3's `bitarray == const int`) or a SINGLE BIT (`c[0] == true`,
// OpenQASM 3's `bit == const bool`). Both are what qiskit accepts, and the
// second is what `to_qasm3` writes — so without it we could not read the file
// we produce.
//
// The boolean spelling is not optional politeness: `c[0] == 1` is `bit ==
// const int`, which strict OpenQASM 3 consumers REJECT. Accepting only the
// integer form here would have entrenched an invalid spelling on both sides
// and made the round trip look healthy.
if_stmt = { "if" ~ "(" ~ cond_target ~ "==" ~ cond_value ~ ")" ~ (if_block | measure_stmt | reset_stmt | gate_app_stmt) }
cond_target = { ident ~ "[" ~ integer ~ "]" | ident }
cond_value  = { bool_lit | integer }
bool_lit    = { "true" | "false" }
if_block = { "{" ~ (measure_stmt | reset_stmt | gate_app_stmt)* ~ "}" }

// Expressions (for gate parameters)
expr = { prefix_op? ~ atom ~ (bin_op ~ prefix_op? ~ atom)* }

atom = {
    fn_call
  | "(" ~ expr ~ ")"
  | "pi"
  | number
  | ident
}

fn_call    = { fn_name ~ "(" ~ expr ~ ")" }
fn_name    = @{ "sin" | "cos" | "tan" | "exp" | "ln" | "sqrt" }
prefix_op  = { "-" }
bin_op     = { "+" | "-" | "*" | "/" }

number  = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ (("e" | "E") ~ ("-" | "+")? ~ ASCII_DIGIT+)? }
integer = @{ ASCII_DIGIT+ }
ident   = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
// Block comments are part of the language and are used by the specification's
// own examples (`adder.qasm`, `vqe.qasm` open with one). Only `//` was handled,
// so those files failed at their first line.
COMMENT    = _{ ("//" ~ (!"\n" ~ ANY)*) | ("/*" ~ (!"*/" ~ ANY)* ~ "*/") }
